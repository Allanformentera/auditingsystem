generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  TREASURER
  AUDITOR
  ADMIN
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum LedgerKind {
  CREDIT
  DEBIT
}

enum MatchStatus {
  MATCHED
  NOT_ON_ROSTER
  AMOUNT_MISMATCH
  PAYMENT_STATUS_MISMATCH
  DUPLICATE
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarPath   String?
  createdAt    DateTime @default(now())
  assessments  Assessment[]
  payments     Payment[]
  expenses     Expense[]
  ledgerEntries LedgerEntry[]
}

model Student {
  id        String   @id @default(cuid())
  studentNo String?  @unique
  firstName String
  lastName  String
  course    String
  major     String   @default("")
  yearLevel Int
  block     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  payments  Payment[]
  @@index([course, yearLevel, block, major, lastName])
  @@unique([course, yearLevel, block, major, firstName, lastName])
}

model Assessment {
  id        String   @id @default(cuid())
  purpose   String
  amount    Decimal  @db.Decimal(12, 2)
  course    String?
  major     String   @default("")
  yearLevel Int?
  block     String?
  dueDate   DateTime?
  createdAt DateTime @default(now())
  createdById String
  createdBy User @relation(fields: [createdById], references: [id])
  payments Payment[]
  @@index([createdAt])
}

model Payment {
  id           String        @id @default(cuid())
  studentId    String
  assessmentId String
  amount       Decimal       @db.Decimal(12, 2)
  status       PaymentStatus @default(UNPAID)
  paidAt       DateTime?
  reference    String?
  recordedById String?
  student      Student       @relation(fields: [studentId], references: [id])
  assessment   Assessment    @relation(fields: [assessmentId], references: [id])
  recordedBy   User?         @relation(fields: [recordedById], references: [id])
  ledgerEntry  LedgerEntry?
  @@unique([studentId, assessmentId])
  @@index([status, assessmentId])
}

model Expense {
  id          String   @id @default(cuid())
  purpose     String
  vendor      String?
  amount      Decimal  @db.Decimal(12, 2)
  spentAt     DateTime
  receiptPath String
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  ledgerEntry LedgerEntry?
}

model LedgerEntry {
  id          String    @id @default(cuid())
  kind        LedgerKind
  amount      Decimal   @db.Decimal(12, 2)
  description String
  createdAt   DateTime  @default(now())
  paymentId   String?   @unique
  expenseId   String?   @unique
  createdById String
  payment     Payment?  @relation(fields: [paymentId], references: [id])
  expense     Expense?  @relation(fields: [expenseId], references: [id])
  createdBy   User      @relation(fields: [createdById], references: [id])
  @@index([kind, createdAt])
}

model PaymentSubmission {
  id          String   @id @default(cuid())
  sourceName  String
  uploadedAt  DateTime @default(now())
  rows        SubmissionRow[]
}

model SubmissionRow {
  id           String      @id @default(cuid())
  submissionId String
  studentName  String
  course       String
  major        String?
  block        String?
  purpose      String?
  reportedAmount Decimal?  @db.Decimal(12, 2)
  status       MatchStatus
  details      String?
  submission   PaymentSubmission @relation(fields: [submissionId], references: [id])
  @@index([status])
}

model CashCount {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  note        String?
  countedAt   DateTime @default(now())
  countedById String
}
